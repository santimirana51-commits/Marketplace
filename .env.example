# Supabase (public values are safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (Indonesia: QRIS/VA/e-wallet/cards, IDR only) — primary paid provider
# Server-only: SB-xxx / SB-Mid-server-xxx (sandbox) or Mid-server-xxx (production)
MIDTRANS_SERVER_KEY=
# Optional: only needed if embedding Snap.js; redirect flow needs no client key
MIDTRANS_CLIENT_KEY=
# 'true' only for production Midtrans account
MIDTRANS_IS_PRODUCTION=false

# Stripe (international cards, optional fallback; unused if keys absent)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Drive (server-only, Vercel-safe). PREFERRED: service account
# (no browser dance, no 7-day test expiry) — share the folder with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Fallback: OAuth refresh-token flow
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated admin emails, e.g. owner@example.com,staff@example.com
ADMIN_EMAILS=

# Gemini AI (server-only). Override the default model if needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Token / download policy defaults
DOWNLOAD_TOKEN_TTL_HOURS=72
DOWNLOAD_MAX_DOWNLOADS=5
