# Supabase (public values are safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Drive (server-only OAuth refresh-token flow for Vercel serverless)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated admin emails, e.g. owner@example.com,staff@example.com
ADMIN_EMAILS=

# Token / download policy defaults
DOWNLOAD_TOKEN_TTL_HOURS=72
DOWNLOAD_MAX_DOWNLOADS=5
